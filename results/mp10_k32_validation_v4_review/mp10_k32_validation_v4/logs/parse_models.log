        writeLines(c("Exactly reused v3 fit and fgsea; historical seed 42 retained.", 
            paste("source", src)), out(paste0(dest, "/REUSE.txt")))
        reused[[i]] <- data.table(comparison_id = paste0("full_", 
            control), candidate_id = "K32", branch = "full", 
            control_cluster = control, model_key = r$model_key, 
            model_dir = dest, origin = "v3_exact_reuse", seed = 42L)
    }, cts <- data.table(branch = c("full", "exclude_P07T", "exclude_P07T"), 
        control_cluster = c("C14", "rest", "C14"), partition = "FULL_Z_r1.00", 
        cluster = "C18", candidate_id = "K32"), cts[, `:=`(comparison_id, 
        paste(branch, control_cluster, sep = "_"))], for (i in 1:nrow(cts)) {
