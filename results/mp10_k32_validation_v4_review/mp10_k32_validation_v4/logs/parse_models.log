        el[c$branch == "exclude_P07T" & sample == excluded_sample, 
            `:=`(reason, "excluded_P07T")]
        wt(el, f("eligibility.tsv"))
        exL <- sweep(as.matrix(L$expression_sum), 2, ifelse(L$n_cells > 
