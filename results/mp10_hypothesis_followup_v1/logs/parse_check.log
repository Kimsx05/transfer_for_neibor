expression(source("mp10_hypothesis_followup_v1/scripts/common.R"), 
    suppressPackageStartupMessages({
        library(edgeR)
        library(GSVA)
        library(decoupleR)
    }), b <- qread(file.path(OLD, "objects/pseudobulk.qs"), nthreads = 1), 
    t <- qread(file.path(B, "objects/treg_strata.qs"), nthreads = 1), 
    q <- old("specimen_exposure_eligibility.tsv"), sr <- rd("signature_registry.tsv"), 
    pr <- rbindlist(list(b$profiles, t$profiles), fill = TRUE), 
    quality <- old("profile_quality.tsv"), pr <- merge(pr, quality, 
        by = "profile_id", suffixes = c("", "_old"), all.x = TRUE), 
    for (n in c("median_nCount", "median_nFeature", "median_mt")) pr[is.na(get(n)), 
        `:=`((n), get(paste0(n, "_old")))], pr[, `:=`(median_log_nCount, 
        log1p(median_nCount))], cells <- old("analysis_cell_metadata.tsv.gz"), 
    mem <- old("pseudobulk_membership.tsv.gz"), ql <- merge(mem[, 
        .(barcode, profile_id)], cells[, .(barcode, nCount_RNA)], 
        by = "barcode", allow.cartesian = TRUE)[, .(median_log_nCount = median(log1p(nCount_RNA))), 
        by = profile_id], pr[ql, on = "profile_id", `:=`(median_log_nCount, 
        i.median_log_nCount)], put(pr, "coverage.tsv.gz"), comp <- rd("treg_cycle_composition.tsv"), 
    out <- list(), cov <- list(), universe <- list(), centers <- list(), 
    norms <- list(), mats <- list(), k <- 0, for (fam in c("Epi_all", 
        "Treg", "Tfh/CXCL13-like", "Capillary EC", "Arterial EC")) {
        reference <- b$profiles[profile_type == fam & n_cells >= 
            30]
        mainref <- reference[main_patient & n_cells >= 50]
        if (nrow(reference) < 2) 
            next
        allp <- if (fam == "Epi_all") 
            pr[profile_type %in% c("Epi_all", "L50", "H50", "H10", 
                "H05")]
        else if (fam == "Treg") 
            pr[profile_type %in% c("Treg", "Treg_NC", "Treg_CY")]
        else pr[profile_type == fam]
        setorder(allp, profile_id)
        refcount <- b$counts[, reference$profile_id, drop = FALSE]
        d <- DGEList(refcount)
        keep <- filterByExpr(d, group = rep(1, nrow(reference)))
        genes <- rownames(refcount)[keep]
        stopifnot(length(genes) > 1000)
        cc <- cbind(b$counts[, intersect(allp$profile_id, colnames(b$counts)), 
            drop = FALSE], t$counts[, intersect(allp$profile_id, 
            colnames(t$counts)), drop = FALSE])
        cc <- cc[, allp$profile_id, drop = FALSE]
        d <- DGEList(cc[genes, , drop = FALSE], lib.size = Matrix::colSums(cc))
        refid <- sort(mainref$profile_id)[1]
        if (is.na(refid)) 
            refid <- sort(reference$profile_id)[1]
        d <- calcNormFactors(d, refColumn = match(refid, colnames(d)))
        mat <- cpm(d, log = TRUE, prior.count = 2)
        center <- rowMeans(mat[, mainref$profile_id, drop = FALSE])
        universe[[fam]] <- data.table(family = fam, gene = genes)
        centers[[fam]] <- data.table(family = fam, gene = genes, 
            center = center, n_reference = nrow(mainref), reference_ids = paste(sort(mainref$profile_id), 
                collapse = ";"))
        norms[[fam]] <- data.table(family = fam, profile_id = colnames(d), 
            raw_RNA_library = d$samples$lib.size, TMM_factor = d$samples$norm.factors, 
            reference_profile = refid)
        mats[[fam]] <- list(logCPM = mat, center = center, profiles = allp, 
            gene_universe = genes, reference_ids = mainref$profile_id)
        for (mask in if (fam == "Epi_all") 
            c("Full", "M20")
        else "Full") {
            mm <- mat[!rownames(mat) %in% if (mask == "M20") 
                M20
            else character(), , drop = FALSE]
            ix <- which(sr$mask == mask & sr$signature != "MP10")
            ss <- sr[ix]
            sets <- lapply(split(ss$gene, ss$signature), unique)
            cv <- rbindlist(lapply(names(sets), function(n) data.table(family = fam, 
                mask = mask, signature = n, n_expected = length(sets[[n]]), 
                n_covered = length(intersect(sets[[n]], rownames(mm))), 
                genes = paste(intersect(sets[[n]], rownames(mm)), 
                  collapse = ";"))))
            cv[, `:=`(evaluable, n_covered >= 5 & n_covered/n_expected >= 
                0.5)]
            cov[[paste(fam, mask)]] <- cv
            valid <- sets[cv[evaluable == TRUE, signature]]
            if (length(valid)) {
                param <- ssgseaParam(mm, valid, minSize = 5, 
                  alpha = 0.25, normalize = FALSE)
                res <- gsva(param, verbose = FALSE, BPPARAM = BiocParallel::SerialParam(progressbar = FALSE))
                z <- as.data.table(as.table(res))
                setnames(z, c("signature", "profile_id", "raw_score"))
                z[, `:=`(metric = paste0(signature, "_", mask), 
                  family = fam, method = "ssGSEA", mask = mask)]
                out[[paste(fam, mask)]] <- z
            }
            if (fam == "Epi_all") 
                for (resource in c("CollecTRI", "DoRothEA_AB")) {
                  net <- fread(file.path(REF, if (resource == 
                    "CollecTRI") 
                    "collectri.tsv"
                  else "dorothea_AB.tsv"))
                  net <- net[source %in% c("SREBF1", "SREBF2")]
                  if (mask == "M20") 
                    net <- net[!target %in% M20]
                  for (variant in if (mask == "M20") 
                    c("standard", "unique", "noNECTIN2")
                  else "standard") {
                    nn <- copy(net)
                    if (variant == "unique") {
                      shared <- nn[, .(n = uniqueN(source)), 
                        by = target][n > 1, target]
                      nn <- nn[!target %in% shared]
                    }
                    if (variant == "noNECTIN2") 
                      nn <- nn[!target %in% c("NECTIN2", "PVRL2")]
                    cv2 <- nn[, .(n_expected = uniqueN(target), 
                      n_covered = uniqueN(target[target %in% 
                        rownames(mm)]), genes = paste(sort(unique(target[target %in% 
                        rownames(mm)])), collapse = ";")), by = source]
                    cv2[, `:=`(family = fam, mask = mask, resource = resource, 
                      variant = variant, signature = source, 
                      evaluable = n_covered >= 5)]
                    cov[[paste(fam, mask, resource, variant)]] <- cv2
                    nn <- nn[source %in% cv2[evaluable == TRUE, 
                      source]]
                    if (!nrow(nn)) 
                      next
                    centered <- sweep(mm, 1, center[rownames(mm)], 
                      "-")
                    ac <- as.data.table(run_ulm(centered, nn, 
                      .source = "source", .target = "target", 
                      .mor = "mor", minsize = 5))
                    setnames(ac, c("condition", "score", "p_value"), 
                      c("profile_id", "raw_score", "ulm_enrichment_p"))
                    ac[, `:=`(metric, paste0(source, "_", mask, 
                      if (resource == "DoRothEA_AB") 
                        "_DoR"
                      else "", if (variant == "standard") 
                        ""
                      else paste0("_", variant)))]
                    ac[, `:=`(family = fam, method = "ULM", mask = mask, 
                      resource = resource, variant = variant)]
                    out[[paste(mask, resource, variant)]] <- ac
                  }
                }
        }
        if (fam == "Epi_all") 
            for (g in c("NECTIN2", "SREBF1", "SREBF2", "PVR")) {
                gn <- if (g == "NECTIN2" && !g %in% rownames(mat) && 
                  "PVRL2" %in% rownames(mat)) 
                  "PVRL2"
                else g
                if (gn %in% rownames(mat)) 
                  out[[paste(fam, g)]] <- data.table(family = fam, 
                    metric = if (g %in% c("SREBF1", "SREBF2")) 
                      paste0(g, "_RNA")
                    else g, profile_id = colnames(mat), raw_score = mat[gn, 
                      ], method = "TMM logCPM", mask = "Full")
            }
        cat("SCORED", fam, nrow(mat), ncol(mat), "\n")
    }, z <- rbindlist(out, fill = TRUE), z <- merge(z, pr[, .(profile_id, 
        sample_uid, profile_type, dataset, patient_uid_recorded, 
        n_cells, main_patient, replacement_patient)], by = "profile_id"), 
    sc <- z[main_patient & n_cells >= 50 & profile_type == family, 
        .(center = mean(raw_score), scale = sd(raw_score), reference_n = .N, 
            reference_ids = paste(sort(profile_id), collapse = ";")), 
        by = .(family, metric)], z <- merge(z, sc, by = c("family", 
        "metric"), all.x = TRUE), z[, `:=`(score, ifelse(is.finite(scale) & 
        scale > 1e-10, (raw_score - center)/scale, NA_real_))], 
    put(z, "sample_level_scores.tsv.gz"), put(sc, "score_scaling_reference.tsv"), 
    put(rbindlist(cov, fill = TRUE), "signature_coverage.tsv"), 
    put(rbindlist(universe), "scoring_gene_universe.tsv.gz"), 
    put(rbindlist(centers), "gene_centering_reference.tsv.gz"), 
    put(rbindlist(norms), "normalization_reference.tsv.gz"), 
    sig <- digest(list(readLines(file.path(B, "config/M0_FROZEN.sha256")), 
        readLines(file.path(B, "objects/treg_strata.qs.sha256")), 
        digest(file.path(S, "04_scores.R"), file = TRUE)), algo = "sha256"), 
    qsave(list(matrices = mats, signature = sig), file.path(B, 
        "objects/scoring_matrices.qs"), nthreads = 1, preset = "high"), 
    writeLines(sig, file.path(B, "objects/scoring_matrices.qs.sha256")), 
    writeLines(capture.output(sessionInfo()), file.path(B, "logs/sessionInfo_scores.txt")), 
    thread_audit("scores_complete"), cat("SCORES COMPLETE\n"))
expression(source("mp10_hypothesis_followup_v1/scripts/common.R"), 
    reg <- rd("model_registry.tsv"), sc <- rd("sample_level_scores.tsv.gz"), 
    pr <- rd("coverage.tsv.gz"), q <- old("specimen_exposure_eligibility.tsv"), 
    cy <- rd("treg_cycle_composition.tsv"), cells <- old("analysis_cell_metadata.tsv.gz"), 
    epi <- cells[analysis_major_c2l_final == "Epithelial"], cl <- epi[!is.na(subtype_v2) & 
        subtype_v2 != "", .N, by = subtype_v2][order(-N)], dominant <- cl$subtype_v2[1], 
    mix <- epi[, .(epi_major_fraction = mean(!is.na(subtype_v2) & 
        subtype_v2 == dominant), missing_subtype_fraction = mean(is.na(subtype_v2) | 
        subtype_v2 == "")), by = sample_uid], put(data.table(metric = "epi_major_fraction", 
        definition = paste("fraction in globally most abundant original cluster", 
            dominant), selection = "cell counts only; before association; missing labels retained in denominator"), 
        "composition_covariate_definition.tsv"), results <- list(), 
    members <- list(), influences <- list(), excluded <- list(), 
    settings <- unique(reg$setting), metric_for <- function(n, 
        setting) {
        if (setting == "Full") 
            n <- sub("_M20$", "_Full", n)
        if (grepl("^SREBF[12]_M20$", n)) {
            n <- paste0(n, switch(setting, DoRothEA_AB = "_DoR", 
                TF_unique = "_unique", remove_NECTIN2 = "_noNECTIN2", 
                ""))
        }
        n
    }, for (i in seq_len(nrow(reg))) {
        r <- reg[i]
        xx <- metric_for(r$x, r$setting)
        yy <- metric_for(r$y, r$setting)
        d <- copy(q[, .(sample_uid, dataset, patient_uid_recorded, 
            main_patient, replacement_patient, Q50, Q95, Q50_z, 
            Q95_z)])
        epr <- pr[profile_type == "Epi_all", .(sample_uid, epi_n = n_cells, 
            epi_RNA = median_log_nCount)]
        d <- merge(d, epr, by = "sample_uid", all.x = TRUE)
        d <- merge(d, mix, by = "sample_uid", all.x = TRUE)
        if (xx == "MP10_Q50") 
            d[, `:=`(x, Q50_z)]
        else if (xx == "MP10_Q95") 
            d[, `:=`(x, Q95_z)]
        else {
            ex <- sc[profile_type == "Epi_all" & metric == xx, 
                .(sample_uid, x = score)]
            d <- merge(d, ex, by = "sample_uid", all.x = TRUE)
        }
        ct <- r$celltype
        rp <- pr[profile_type == ct, .(sample_uid, n_cells, receiver_RNA = median_log_nCount, 
            receiver_MT = median_mt)]
        d <- merge(d, rp, by = "sample_uid", all.x = TRUE)
        d <- merge(d, cy[, .(sample_uid, n_cycling, n_noncycling, 
            n_invalid, cycling_adjust = cycling_fraction)], by = "sample_uid", 
            all.x = TRUE)
        if (r$method == "quasibinomial") 
            d[, `:=`(y, cycling_adjust)]
        else {
            ys <- sc[profile_type == ct & metric == yy, .(sample_uid, 
                y = score)]
            d <- merge(d, ys, by = "sample_uid", all.x = TRUE)
        }
        d[, `:=`(patient_ok, if (r$patient == "main") 
            main_patient
        else replacement_patient)]
        d[, `:=`(coverage_ok, !is.na(n_cells) & n_cells >= r$min_cells & 
            epi_n >= r$min_cells)]
        if (r$cohort == "NC_matched") {
            nc <- pr[profile_type == "Treg_NC" & n_cells >= r$min_cells, 
                sample_uid]
            d[, `:=`(coverage_ok, coverage_ok & sample_uid %in% 
                nc)]
        }
        d[, `:=`(dataset_ok, r$omit_dataset == "none" | dataset != 
            r$omit_dataset)]
        d[, `:=`(values_ok, is.finite(x) & is.finite(y))]
        if (r$method == "quasibinomial") 
            d[, `:=`(values_ok, values_ok & n_invalid == 0)]
        if (r$covariate != "none") 
            d[, `:=`(values_ok, values_ok & is.finite(get(r$covariate)))]
        d[, `:=`(included, patient_ok & coverage_ok & dataset_ok & 
            values_ok)]
        d[, `:=`(exclusion_reason, fifelse(!patient_ok, "patient_representative", 
            fifelse(!dataset_ok, "LODO", fifelse(!coverage_ok, 
                "profile_below_min_cells_or_absent", fifelse(!values_ok, 
                  "missing_score_or_invalid_classification", 
                  "included")))))]
        excluded[[i]] <- d[, .(model_id = r$model_id, sample_uid, 
            celltype = ct, n_cells, x, y, cycling_adjust, receiver_RNA, 
            receiver_MT, epi_RNA, exclusion_reason, included)]
        dd <- d[included == TRUE]
        setorder(dd, sample_uid)
        n <- nrow(dd)
        nu <- uniqueN(dd$patient_uid_recorded)
        nd <- uniqueN(dd$dataset)
        reason <- ""
        status <- "completed"
        beta <- se <- lo <- hi <- p <- disp <- df <- rank <- maxhat <- NA_real_
        if (nu < 4) 
            reason <- "fewer_than_4_recorded_patient_units"
        if (n != nu) 
            stop("Repeated recorded patient units in model ", 
                r$model_id)
        if (!nzchar(reason)) {
            terms <- c(if (nd > 1) "dataset", if (r$covariate != 
                "none") r$covariate, "x")
            form <- reformulate(terms, response = if (r$method == 
                "quasibinomial") 
                "cbind(n_cycling,n_noncycling)"
            else "y")
            X <- model.matrix(reformulate(terms), dd)
            rank <- qr(X)$rank
            df <- n - rank
            if (rank < ncol(X)) 
                reason <- "rank_deficient"
            else if (df < 3) 
                reason <- "residual_df_below_3"
            else if (sd(dd$x) < 1e-10) 
                reason <- "no_predictor_variation"
            else if (sd(dd$y) < 1e-10) 
                reason <- "no_endpoint_variation"
            if (!nzchar(reason)) 
                tryCatch({
                  if (r$method == "HC3") {
                    fit <- lm(form, dd)
                    h <- hatvalues(fit)
                    if (any(h >= 1 - 1e-10)) 
                      stop("unit_leverage_HC3_undefined")
                    V0 <- solve(crossprod(X))
                    V <- V0 %*% crossprod(X, X * as.numeric(residuals(fit)^2/(1 - 
                      h)^2)) %*% V0
                    beta <- coef(fit)["x"]
                    se <- sqrt(V["x", "x"])
                    maxhat <- max(h)
                    influences[[i]] <- data.table(model_id = r$model_id, 
                      sample_uid = dd$sample_uid, leverage = h, 
                      cooks_distance = cooks.distance(fit), standardized_residual = rstandard(fit), 
                      x = dd$x, y = dd$y)
                  }
                  else {
                    fit <- glm(form, dd, family = quasibinomial())
                    ss <- summary(fit)
                    beta <- coef(fit)["x"]
                    se <- ss$coefficients["x", "Std. Error"]
                    disp <- ss$dispersion
                    h <- hatvalues(fit)
                    maxhat <- max(h)
                    if (!fit$converged || !is.finite(disp) || 
                      disp <= 0 || se > 10 || any(!is.finite(coef(fit)))) 
                      stop("quasibinomial_degenerate_or_separated")
                    influences[[i]] <- data.table(model_id = r$model_id, 
                      sample_uid = dd$sample_uid, leverage = h, 
                      cooks_distance = cooks.distance(fit), standardized_residual = rstandard(fit), 
                      x = dd$x, y = dd$y)
                  }
                  if (!is.finite(se) || se <= 0) 
                    stop("invalid_SE")
                  p <- 2 * pt(-abs(beta/se), df)
                  lo <- beta - qt(0.975, df) * se
                  hi <- beta + qt(0.975, df) * se
                }, error = function(e) {
                  reason <<- conditionMessage(e)
                })
        }
        if (nzchar(reason)) {
            status <- "not_evaluable"
            beta <- se <- lo <- hi <- p <- NA_real_
        }
        members[[i]] <- dd[, .(model_id = r$model_id, sample_uid, 
            patient_uid_recorded, dataset, celltype = ct, n_cells, 
            x, y, epi_RNA, receiver_RNA, receiver_MT, cycling_fraction = cycling_adjust)]
        results[[i]] <- cbind(r, data.table(metric_x = xx, metric_y = yy, 
            status = status, reason = reason, beta = beta, se = se, 
            CI_low = lo, CI_high = hi, P = p, n_specimens = n, 
            n_recorded_patient_units = nu, n_datasets = nd, dataset_counts = paste(dd[, 
                .N, by = dataset][order(dataset), paste0(dataset, 
                ":", N)], collapse = ";"), residual_df = df, 
            design_rank = rank, dispersion = disp, max_leverage = maxhat, 
            input_hash = digest(list(dd, xx, yy, r), algo = "sha256"), 
            OR = if (r$method == "quasibinomial") 
                exp(beta)
            else NA_real_, OR_low = if (r$method == "quasibinomial") 
                exp(lo)
            else NA_real_, OR_high = if (r$method == "quasibinomial") 
                exp(hi)
            else NA_real_))
        if (i%%100 == 0) 
            cat("MODELS", i, nrow(reg), "\n")
    }, z <- rbindlist(results, fill = TRUE), z[, `:=`(q, p.adjust(P, 
        "BH", n = unique(planned_n))), by = FDR_family], z[, 
        `:=`(testable_n, sum(is.finite(P))), by = FDR_family], 
    put(z, "model_results.tsv.gz"), put(rbindlist(members, fill = TRUE), 
        "model_membership.tsv.gz"), put(rbindlist(excluded, fill = TRUE), 
        "model_eligibility.tsv.gz"), put(rbindlist(influences, 
        fill = TRUE), "model_influence.tsv.gz"), put(z[, .(planned_n = unique(planned_n), 
        registered_n = .N, testable_n = sum(is.finite(P)), n_NE = sum(status != 
            "completed")), by = FDR_family], "FDR_family_audit.tsv"), 
    thread_audit("models_complete"), cat("MODELS COMPLETE\n"))
parse OK