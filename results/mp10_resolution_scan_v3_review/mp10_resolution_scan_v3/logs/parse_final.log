    wt(rbindlist(allshort, fill = TRUE), "08_review/all_shortlists.tsv"), 
    fs <- rbindlist(fun, fill = TRUE), wt(fs, "08_review/function_family_summary.tsv"), 
    for (k in can$candidate_id) {
