        other_lipid = "LIPID|PHOSPHOLIPID|SPHINGO|TRIGLYCERIDE", 
        response_stress = "STRESS|RESPONSE_TO|HEAT_SHOCK|UNFOLDED_PROTEIN", 
        proliferation = "CELL_CYCLE|MITOTIC|DNA_REPLICATION", 
        epithelial = "EPITHELI|KERATIN|CELL_CELL_ADHESION|TIGHT_JUNCTION"), 
    familygenes <- lapply(families, function(p) unique(unlist(sets[grepl(p, 
