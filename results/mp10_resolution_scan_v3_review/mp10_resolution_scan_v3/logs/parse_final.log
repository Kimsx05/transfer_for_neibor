                    det_left = mean(det_left), det_right = mean(det_right), 
                    n_samples = .N, positive_fraction = mean(delta > 
                      0)), by = .(gene_id, candidate_id, comparison_id, 
                    control_type)]
                  dd[, `:=`(scope, ds)]
                  dot[[length(dot) + 1L]] <- dd
                }
            }
