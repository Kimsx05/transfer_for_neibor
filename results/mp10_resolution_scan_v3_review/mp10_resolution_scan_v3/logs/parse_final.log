                    qual])))
                d <- merge(d, sm, by = "sample", all.x = TRUE)
                d[, `:=`(candidate_id = k, comparison_id = cc$comparison_id, 
                  control_type = cc$control_type, delta = expr_left - 
                    expr_right)]
