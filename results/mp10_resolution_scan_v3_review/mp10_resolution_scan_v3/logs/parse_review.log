expression(source("/home/data/t070721/codex_workspace/Bladder Metabolism/mp10_resolution_scan_v3/code/00_common.R"), 
    stopifnot(file.exists(out("04_pseudobulk_markers/COMPLETE"))), 
    can <- fread(out("03_candidates/candidates_preDE.tsv")), 
    cts <- fread(out("04_pseudobulk_markers/model_summary.tsv")), 
    ann <- fread(out("00_audit/gene_annotation.tsv.gz")), sets <- qread(out("05_function/frozen_GO_BP_Reactome.qs")), 
    md <- qread(out("00_audit/cell_metadata.qs")), sm <- unique(md[, 
        .(sample, dataset, source)]), sig <- fread(file.path(old, 
        "01_signatures/top50_signatures.tsv")), display <- list(), 
    allshort <- list(), fun <- list(), dot <- list(), directions <- list(), 
    eligs <- list(), funall <- list(), families <- list(fatty_acid = "FATTY_ACID", 
        cholesterol_sterol = "CHOLESTEROL|STEROL|MEVALONATE", 
        other_lipid = "LIPID|PHOSPHOLIPID|SPHINGO|TRIGLYCERIDE", 
        response_stress = "STRESS|RESPONSE_TO|HEAT_SHOCK|UNFOLDED_PROTEIN", 
        proliferation = "CELL_CYCLE|MITOTIC|DNA_REPLICATION", 
        epithelial = "EPITHELI|KERATIN|CELL_CELL_ADHESION|TIGHT_JUNCTION"), 
    familygenes <- lapply(families, function(p) unique(unlist(sets[grepl(p, 
        names(sets))]))), familyof <- function(g) {
        f <- names(familygenes)[vapply(familygenes, function(x) g %in% 
            x, logical(1))]
        if (length(f)) 
            paste(f, collapse = ";")
        else "unclassified"
    }, for (i in 1:nrow(cts)) {
        ct <- cts[i]
        dir <- paste0("04_pseudobulk_markers/models/", ct$model_key, 
            "/")
        el <- fread(out(paste0(dir, "eligibility.tsv")))
        el[, `:=`(comparison_id, ct$comparison_id)]
        eligs[[i]] <- el
        if (ct$status != "COMPLETE") 
            next
        sh <- fread(out(paste0(dir, "shortlist.tsv")))
        sh[, `:=`(comparison_id = ct$comparison_id, candidate_id = ct$candidate_id, 
            control_type = ct$control_type)]
        allshort[[length(allshort) + 1L]] <- sh
        fg <- fread(out(paste0("05_function/", ct$model_key, 
            "/enrichment_all.tsv.gz")))
        for (di in c("positive", "negative")) {
            za <- fg[is.finite(padj) & if (di == "positive") 
                NES > 0
            else NES < 0]
            setorderv(za, c("padj", "NES", "pathway"), c(1, if (di == 
                "positive") -1 else 1, 1))
            za <- head(za, 10)
            za[, `:=`(comparison_id = ct$comparison_id, candidate_id = ct$candidate_id, 
                control_type = ct$control_type, direction = di)]
            funall[[length(funall) + 1L]] <- za
        }
        for (fa in names(families)) {
            z <- fg[grepl(families[[fa]], pathway)]
            if (fa == "other_lipid") 
                z <- z[!grepl("FATTY_ACID|CHOLESTEROL|STEROL|MEVALONATE", 
                  pathway)]
            for (di in c("positive", "negative")) {
                zz <- z[is.finite(padj) & if (di == "positive") 
                  NES > 0
                else NES < 0]
                setorderv(zz, c("padj", "NES", "pathway"), c(1, 
                  if (di == "positive") -1 else 1, 1))
                zz <- head(zz, 3)
                zz[, `:=`(comparison_id = ct$comparison_id, candidate_id = ct$candidate_id, 
                  control_type = ct$control_type, function_family = fa, 
                  direction = di)]
                fun[[length(fun) + 1L]] <- zz
            }
        }
    }, wt(rbindlist(eligs), "04_pseudobulk_markers/all_comparison_eligibility.tsv"), 
    wt(rbindlist(allshort, fill = TRUE), "08_review/all_shortlists.tsv"), 
    fs <- rbindlist(fun, fill = TRUE), wt(fs, "08_review/function_family_summary.tsv"), 
    wt(rbindlist(funall, fill = TRUE), "08_review/function_top_all_pathways.tsv"), 
    for (k in can$candidate_id) {
        ct <- cts[candidate_id == k]
        rest <- ct[control_type == "rest"]
        loc <- ct[control_type == "local"]
        chosen <- data.table(gene_id = character(), in_any_14MP_top50 = logical())
        if (rest$status == "COMPLETE") {
            r <- fread(out(paste0("04_pseudobulk_markers/models/", 
                rest$model_key, "/DE_full.tsv.gz")))
            r <- r[FDR < 0.05 & log2FC >= 0.5 & pct_left >= 0.1 & 
                positive_fraction >= 0.7]
            r[, `:=`(local_qualified, FALSE)]
            if (loc$status == "COMPLETE") {
                l <- fread(out(paste0("04_pseudobulk_markers/models/", 
                  loc$model_key, "/DE_full.tsv.gz")))
                ll <- l[FDR < 0.05 & log2FC >= 0.5 & pct_left >= 
                  0.1 & positive_fraction >= 0.7, gene_id]
                r[, `:=`(local_qualified, gene_id %in% ll)]
                r <- r[local_qualified == TRUE]
            }
            else {
                r[, `:=`(local_qualified, NA)]
            }
            r[, `:=`(function_family, vapply(gene_id, familyof, 
                character(1)))]
            r[, `:=`(gene_family_prefix, sub("[0-9].*$", "", 
                gene_id))]
            r[, `:=`(has_symbol, !is.na(gene_symbol))]
            setorderv(r, c("has_symbol", "in_any_14MP_top50", 
                "positive_fraction", "detection_delta", "log2FC", 
                "gene_id"), c(-1, 1, -1, -1, -1, 1))
            picked <- integer()
            usedprefix <- character()
            usedcat <- character()
            for (j in seq_len(nrow(r))) {
                if (length(picked) >= 3) 
                  break
                if (r$gene_family_prefix[j] %in% usedprefix) 
                  next
                if (length(picked) > 0 && r$function_family[j] %in% 
                  usedcat && any(!r$function_family[seq_len(nrow(r))] %in% 
                  usedcat)) 
                  next
                picked <- c(picked, j)
                usedprefix <- c(usedprefix, r$gene_family_prefix[j])
                usedcat <- c(usedcat, r$function_family[j])
            }
            chosen <- r[picked]
            if (nrow(chosen)) {
                for (ty in c("local", "carrier")) {
                  ccx <- ct[control_type == ty]
                  if (nrow(ccx) && ccx$status == "COMPLETE") {
                    ev <- fread(out(paste0("04_pseudobulk_markers/models/", 
                      ccx$model_key, "/DE_full.tsv.gz")))
                    ev <- ev[match(chosen$gene_id, gene_id)]
                    for (v in c("log2FC", "FDR", "detection_delta", 
                      "positive_fraction")) chosen[, `:=`((paste0(ty, 
                      "_", v)), ev[[v]])]
                  }
                }
            }
            chosen[, `:=`(candidate_id = k, selection_reason = if (loc$status == 
                "COMPLETE") 
                "passes rest and nearest-local fixed gates; non-input priority, diverse gene prefix/function annotations"
            else "rest-supported only; local NOT_TESTABLE; no local specificity claim")]
            if (nrow(chosen)) 
                display[[k]] <- chosen
        }
        can[candidate_id == k, `:=`(display_markers = paste(chosen$gene_id, 
            collapse = ";"), non_input_markers = paste(chosen[in_any_14MP_top50 == 
            FALSE, gene_id], collapse = ";"), marker_status = if (rest$status != 
            "COMPLETE") 
            "NOT_TESTABLE_rest"
        else if (loc$status != "COMPLETE") 
            "local_NOT_TESTABLE"
        else if (nrow(chosen) == 0) 
            "no_gene_passes_rest_and_local_gates"
        else "paired_local_supported", rest_pairs = rest$n_pairs, 
            local_pairs = loc$n_pairs)]
        if (nrow(chosen)) 
            for (j in 1:nrow(ct)) {
                cc <- ct[j]
                a <- qread(out(paste0("04_pseudobulk_markers/models/", 
                  cc$model_key, "/sample_expression.qs")))
                ix <- match(chosen$gene_id, a$genes)
                qual <- which(a$eligible)
                if (!length(qual)) 
                  next
                d <- rbindlist(lapply(seq_along(ix), function(z) data.table(gene_id = chosen$gene_id[z], 
                  sample = a$samples[qual], expr_left = a$expression_left[ix[z], 
                    qual], expr_right = a$expression_right[ix[z], 
                    qual], det_left = a$detection_left[ix[z], 
                    qual], det_right = a$detection_right[ix[z], 
                    qual])))
                d <- merge(d, sm, by = "sample", all.x = TRUE)
                d[, `:=`(candidate_id = k, comparison_id = cc$comparison_id, 
                  control_type = cc$control_type, delta = expr_left - 
                    expr_right)]
                directions[[length(directions) + 1L]] <- d
                for (ds in c("ALL", sort(unique(md$dataset)))) {
                  dd <- if (ds == "ALL") 
                    d
                  else d[dataset == ds]
                  if (!nrow(dd)) 
                    next
                  dd <- dd[, .(expr_left = mean(expr_left), expr_right = mean(expr_right), 
                    det_left = mean(det_left), det_right = mean(det_right), 
                    n_samples = .N, positive_fraction = mean(delta > 
                      0)), by = .(gene_id, candidate_id, comparison_id, 
                    control_type)]
                  dd[, `:=`(scope, ds)]
                  dot[[length(dot) + 1L]] <- dd
                }
            }
    }, wt(rbindlist(display, fill = TRUE), "08_review/display_marker_evidence.tsv"), 
    wt(rbindlist(dot, fill = TRUE), "08_review/display_marker_DotPlot_data.tsv"), 
    wt(rbindlist(directions, fill = TRUE), "08_review/display_marker_sample_directions.tsv.gz"), 
    cov <- fread(out("02_coverage/candidate_source_coverage.tsv")), 
    eq <- fread(out("02_coverage/sample_equal_summary.tsv")), 
    for (i in 1:nrow(can)) {
        k <- can$candidate_id[i]
        s <- cov[candidate_id == k & high == "NMF" & field == 
            "sample"]
        ds <- cov[candidate_id == k & high == "NMF" & field == 
            "dataset"]
        src <- cov[candidate_id == k & high == "NMF" & field == 
            "source"]
        a <- s[which.max(contribution)]
        b <- ds[which.max(contribution)]
        f <- fs[candidate_id == k & control_type == "rest" & 
            direction == "positive" & padj < 0.05]
        funstr <- if (nrow(f)) 
            paste(unique(f$function_family), collapse = ";")
        else "no_positive_family_FDR_lt05"
        can[i, `:=`(n_samples_present = sum(s$n_candidate > 0), 
            n_datasets_present = sum(ds$n_candidate > 0), max_sample = a$level, 
            max_sample_contribution = a$contribution, max_dataset = b$level, 
            max_dataset_contribution = b$contribution, source_composition = paste(paste0(src$level, 
                ":", src$n_candidate), collapse = ";"), NMF_zero_recall = eq[candidate_id == 
                k & high == "NMF", n_high_zero_recall], UCell_zero_recall = eq[candidate_id == 
                k & high == "UCell", n_high_zero_recall], function_summary = funstr, 
            limitations = paste("Discovery RNA; sample not verified patient;", 
                if (b$contribution > 0.5) 
                  "one dataset >50%;"
                else "", if (a$contribution > 0.25) 
                  "one sample >25%;"
                else "", can$marker_status[i]))]
    }, wt(can, "08_review/FINAL_CANDIDATES.tsv"), wt(can[recommended == 
        TRUE], "08_review/RECOMMENDED_CANDIDATES.tsv"), keycan <- can[recommended == 
        TRUE], restcts <- cts[candidate_id %in% keycan$candidate_id & 
        control_type == "rest"], shared <- Reduce(intersect, 
        lapply(restcts$model_key, function(k) fread(out(paste0("04_pseudobulk_markers/models/", 
            k, "/eligibility.tsv")))[eligible == TRUE, sample])), 
    oldpb <- qread(file.path(v2, "02_pseudobulk_markers/r04_C8_vs_rest_pseudobulk.qs")), 
    shared <- intersect(shared, oldpb$meta[eligible == TRUE, 
        sample]), gg <- sort(unique(c(unlist(strsplit(keycan$display_markers, 
        ";", fixed = TRUE)), sig[MP == "EpiMP10", gene]))), gg <- gg[nzchar(gg)], 
    sh <- list(), if (length(shared)) {
        for (i in 1:nrow(restcts)) {
            cc <- restcts[i]
            a <- qread(out(paste0("04_pseudobulk_markers/models/", 
                cc$model_key, "/sample_expression.qs")))
            ix <- match(gg, a$genes)
            ss <- match(shared, a$samples)
            de <- a$expression_left[ix, ss, drop = FALSE] - a$expression_right[ix, 
                ss, drop = FALSE]
            sh[[length(sh) + 1L]] <- data.table(candidate_id = cc$candidate_id, 
                gene_id = gg, n_common_samples = length(shared), 
                mean_delta = rowMeans(de), positive_fraction = rowMeans(de > 
                  0))
        }
        ix <- match(gg, rownames(oldpb$expression))
        li <- match(paste(shared, "Left", sep = "::"), oldpb$meta$column_id)
        ri <- match(paste(shared, "Right", sep = "::"), oldpb$meta$column_id)
        de <- oldpb$expression[ix, li, drop = FALSE] - oldpb$expression[ix, 
            ri, drop = FALSE]
        sh[[length(sh) + 1L]] <- data.table(candidate_id = "old_C8", 
            gene_id = gg, n_common_samples = length(shared), 
            mean_delta = rowMeans(de), positive_fraction = rowMeans(de > 
                0))
    }, wt(data.table(sample = shared), "08_review/shared_eligible_samples.tsv"), 
    if (length(sh)) wt(rbindlist(sh), "08_review/shared_sample_marker_directions.tsv"), 
    writeLines("complete", out("08_review/TABLES_COMPLETE")), 
    logmsg("Candidate review complete"))
