expression(source("/home/data/t070721/codex_workspace/Bladder Metabolism/mp10_resolution_scan_v3/code/00_common.R"), 
    can <- fread(out("08_review/FINAL_CANDIDATES.tsv")), ct <- fread(out("04_pseudobulk_markers/model_summary.tsv")), 
    jac <- fread(out("06_stability/candidate_Jaccard.tsv")), 
    pr <- fread(out("03_candidates/candidate_14MP_profiles.tsv")), 
    dm <- fread(out("08_review/display_marker_evidence.tsv")), 
    genes <- sort(unique(dm$gene_id)), cache <- list(), for (k in can$candidate_id) {
        m <- ct[candidate_id == k & control_type == "rest"]
        a <- qread(out(paste0("04_pseudobulk_markers/models/", 
            m$model_key, "/sample_expression.qs")))
        ix <- match(genes, a$genes)
        de <- a$expression_left[ix, , drop = FALSE] - a$expression_right[ix, 
            , drop = FALSE]
        rownames(de) <- genes
        colnames(de) <- a$samples
        cache[[k]] <- list(delta = de, eligible = a$samples[a$eligible])
        rm(a)
        gc()
    }, cor_safe <- function(a, b) {
        if (length(a) < 2 || sd(a) == 0 || sd(b) == 0) 
            NA_real_
        else cor(a, b, method = "spearman")
    }, rows <- list(), for (i in 1:nrow(jac)) {
        j <- jac[i]
        a <- cache[[j$candidate_A]]
        b <- cache[[j$candidate_B]]
        ss <- intersect(a$eligible, b$eligible)
        gg <- unique(dm[candidate_id %in% c(j$candidate_A, j$candidate_B), 
            gene_id])
        pa <- pr[candidate_id == j$candidate_A][match(mp, MP), 
            raw_mean]
        pb <- pr[candidate_id == j$candidate_B][match(mp, MP), 
            raw_mean]
        jac[i, `:=`(n_common_eligible_samples = length(ss), raw14MP_profile_spearman = cor_safe(pa, 
            pb))]
        if (length(ss) && length(gg)) {
            da <- a$delta[gg, ss, drop = FALSE]
            db <- b$delta[gg, ss, drop = FALSE]
            rows[[length(rows) + 1L]] <- data.table(candidate_A = j$candidate_A, 
                candidate_B = j$candidate_B, type = j$type, gene_id = gg, 
                n_common_samples = length(ss), mean_delta_A = rowMeans(da), 
                mean_delta_B = rowMeans(db), positive_fraction_A = rowMeans(da > 
                  0), positive_fraction_B = rowMeans(db > 0), 
                sample_direction_agreement = rowMeans(sign(da) == 
                  sign(db)))
        }
    }, wt(jac, "06_stability/candidate_Jaccard_and_profile_concordance.tsv"), 
    if (length(rows)) wt(rbindlist(rows), "06_stability/candidate_pair_shared_sample_marker_directions.tsv"), 
    logmsg("Expression stability descriptions complete"))
