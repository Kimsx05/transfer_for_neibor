Package: scTenifoldNet
Type: Package
Title: Construct and Compare scGRN from Single-Cell Transcriptomic Data
Version: 1.4.3
Authors@R: c(person(given = "Daniel", family = "Osorio", email = "dcosorioh@gmail.com", role = c("aut","cre"), comment = c(ORCID = '0000-0003-4424-8422')),
             person(given = "Yan", family = "Zhong", role = c("aut","ctb")),
